#!/bin/sh
set -eu
root=$(git rev-parse --show-toplevel)
if [ "$(git config --local --get conclave.pushAuthorized || true)" != true ]; then
  echo 'publish-guard: pushing is locked until release is explicitly authorized.' >&2
  exit 1
fi
expected=$(git config --local --get conclave.privateRemoteUrl || true)
if [ -z "$expected" ] || [ "$2" != "$expected" ]; then
  echo 'publish-guard: only the configured private release remote may receive local pushes.' >&2
  exit 1
fi
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$local_ref" != refs/heads/main ] || [ "$remote_ref" != refs/heads/main ]; then
    echo 'publish-guard: only main may be pushed; tags, notes, other branches and deletions are blocked.' >&2
    exit 1
  fi
  python3 "$root/scripts/publish-guard.py" history "$local_sha"
done
