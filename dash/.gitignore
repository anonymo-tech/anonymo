# Local material never belongs in the release tree.
/internal/
**/node_modules/
**/dist/
**/build/
**/.next/
**/.vinext/
**/.wrangler/
**/.vercel/
**/.cache/
**/coverage/
**/*.tsbuildinfo
**/__pycache__/
**/*.pyc
**/*.pyo
**/.DS_Store
**/Thumbs.db
**/.env
**/.env.*
**/.dev.vars
**/.dev.vars.*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.keystore
**/*.zip
**/*.pdf
**/AGENTS.md
**/CLAUDE.md
**/.claude/
**/.codex/
**/.openai/
/docs/
/evidence/
/handoff/
/preview/
/MANIFEST*
**/.audit-grade/
**/.solidity-auditor/

# Application-local exclusions.
# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js / vinext
/.next/
/.vinext/
/out/
next-env.d.ts

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local environment and Wrangler secrets
.env*
.dev.vars*

# build output and local tool state
.vercel
/dist/
/.wrangler/
/tmp/
*.tsbuildinfo
