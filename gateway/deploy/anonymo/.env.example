# Anonymo production variables for docker-compose.yml + docker-compose.anonymo.yml (WS10).
# NAMES ONLY. Never commit real values: keep them in the platform's secret store, or in an operator-only file outside
# the repository (mode 600) passed with --env-file. Values marked <secret> are credentials.
# A real deployment must also keep ANONYMO_FLOOR_REQUIRED=1, which the overlay sets on every app container.

# ---- images (each pinned by sha256 digest, never a mutable tag) ----------------------------------------------------
ANONYMO_IMAGE=registry.example.invalid/anonymo-gateway@sha256:<digest>
DASH_IMAGE=registry.example.invalid/anonymo-dash@sha256:<digest>
TIMESCALE_IMAGE=timescale/timescaledb:2.31.0-pg16@sha256:322ae364eca3321cf2a48f1ef31213b87843413b3cf8feeebf54e999a26bb731
POSTGRES_IMAGE=timescale/timescaledb:2.31.0-pg16@sha256:322ae364eca3321cf2a48f1ef31213b87843413b3cf8feeebf54e999a26bb731
REDIS_IMAGE=redis:8.0.4@sha256:a377481f6820efffb07a879de1703a0f6086e188b9aa89f5801563631166090b
CADDY_IMAGE=caddy:2.11.9-alpine@sha256:0bbb055bda6793c999bde78b1b5ce3e89f829fb031af2cf50056ea1246559fee
BACKUP_IMAGE=registry.example.invalid/anonymo-backup@sha256:<digest>

# ---- public names ---------------------------------------------------------------------------------------------------
PUBLIC_BASE_URL=https://api.example.invalid
ANONYMO_API_HOST=api.example.invalid
ANONYMO_DASH_HOST=app.example.invalid
# The CDN header that carries the 2-letter country code. The edge copies only this value into x-anonymo-country.
EDGE_COUNTRY_HEADER=CF-IPCountry

# ---- storage ----------------------------------------------------------------------------------------------------------
POSTGRES_USER=anonymo_owner
POSTGRES_DB=anonymo
POSTGRES_PASSWORD=<secret>
# Migration/schema owner (runs migrations, grants and the Timescale ops step).
MIGRATION_DATABASE_URL=postgres://anonymo_owner:<secret>@postgres:5432/anonymo
# Runtime DML-only role created by scripts/production-db-runtime-role.sql.
RUNTIME_DB_PASSWORD=<secret>
DATABASE_URL=postgres://anonymo_runtime:<secret>@postgres:5432/anonymo
REDIS_PASSWORD=<secret>
REDIS_URL=redis://:<secret>@redis:6379
REQUESTS_RETENTION_DAYS=30

# ---- application secrets ------------------------------------------------------------------------------------------
APP_SECRET=<secret>
ADMIN_TOKEN=<secret>
# Anonymo runs contract-free: leave ROUTER_PRIVATE_KEY and SETTLEMENT_PRIVATE_KEY unset (the settlement worker sits
# behind the anonymo-contracts profile). From rollout A3, set the anchoring key together with the ReceiptRoots address
# (gateway/contracts/deployments/4663-anonymo-receipts.json); the key's address is ANONYMO_RECEIPT_SIGNER at deploy.
ANCHORER_PRIVATE_KEY=
ANONYMO_RECEIPT_ROOTS_ADDRESS=

# ---- chain (read by the deposit and chain indexers; the router runs without the Anonymo contracts) ---------------
RHC_RPC_URL=https://rpc.example.invalid

# ---- provider and upstream seeds (files outside the repo holding only key variables) ---------------------------------
PROVIDERS_MANIFEST=/srv/anonymo/providers.yaml
PROVIDER_SECRETS_FILE=/srv/anonymo/provider-secrets.env
# PPQ_API_KEY and PPQ_CREDIT_ID (the shipped config is PPQ only), plus the key of any provider you add from
# test/fixtures/upstreams-multi.yaml: read once by upstreams-init and stored encrypted with APP_SECRET.
UPSTREAM_SECRETS_FILE=/srv/anonymo/upstream-secrets.env

# ---- floor gate (required) ------------------------------------------------------------------------------------------
# gpt-oss-safeguard on NanoGPT (paid in crypto), pinned to its Groq route: NanoGPT's other route for this model is
# too slow to use. It checks every prompt and every reply. A NanoGPT key with request logging left off (the default).
# Paying by card instead: Groq directly (https://api.groq.com/openai/v1, Developer plan, Zero Data Retention on in Data
# Controls) with ANONYMO_FLOOR_EXTRA_BODY unset.
# PayPerQ resells the same model from a shared, often rate-limited pool, so it is the fallback, asked only when the
# first guard errors. Its key can be PPQ_API_KEY itself, or a second PPQ key that can be revoked without stopping chat. Self-hosting Llama Guard instead: infra/gpu/docker-compose.guard.yml with ANONYMO_FLOOR_FORMAT=llama-guard.
ANONYMO_FLOOR_URL=https://api.nano-gpt.com/api/v1
ANONYMO_FLOOR_MODEL=openai/gpt-oss-safeguard-20b
ANONYMO_FLOOR_FORMAT=safeguard
ANONYMO_FLOOR_KEY=<secret>
ANONYMO_FLOOR_EXTRA_BODY={"provider":{"only":["groq"],"allow_fallbacks":false}}
ANONYMO_FLOOR_FALLBACK_URL=https://api.ppq.ai/v1
ANONYMO_FLOOR_FALLBACK_MODEL=openai/gpt-oss-safeguard-20b
ANONYMO_FLOOR_FALLBACK_KEY=<secret>
ANONYMO_FLOOR_TIMEOUT_MS=8000
ANONYMO_FLOOR_CACHE_MINUTES=60
# A second, independent check for sexual content involving minors: Meta's Llama Guard 4 with its own taxonomy, read for
# S4 (Child Sexual Exploitation) only, on PPQ (the same PPQ key as the fallback's). It reads every prompt and
# every reply beside the guard, and either one blocks.
ANONYMO_FLOOR_LLAMAGUARD_URL=https://api.ppq.ai/v1
ANONYMO_FLOOR_LLAMAGUARD_KEY=<secret>
# Optional: OpenAI's moderation endpoint as a further check (sexual/minors). Its free tier allows only 10,000 tokens a
# minute for this model, which a handful of parallel chats exhausts, and the floor then fails closed.
# ANONYMO_FLOOR_OPENAI_KEY=<secret>
# Refusal classifier (optional): unset, the phrase rules decide. It needs a self-hosted model (docker-compose.guard.yml).
# ANONYMO_REFUSAL_URL=https://guard.internal.example.invalid/refusal/v1
# ANONYMO_REFUSAL_MODEL=refusal-classifier
# ANONYMO_REFUSAL_KEY=<secret>

# ---- region rules (country codes, comma-separated) -------------------------------------------------------------------
# Empty means the cautious defaults in src/anonymo/region/rules.ts (reasons and sources: docs/legal/region-defaults.md):
# with no age verification, every region whose rules plausibly reach adult text is blocked outright, plus sanctions.
# A value replaces the list; "none" empties it.
ANONYMO_REGION_BLOCKED=
ANONYMO_AGE_VERIFICATION_REGIONS=
# An unknown region (no country header, Tor) is blocked in production by default; "allow" lets it through.
ANONYMO_REGION_UNKNOWN_TEXT=

# ---- media (WS06; infra/gpu/docker-compose.comfyui.yml) -------------------------------------------------------------
# Images and video are safe for work only, in every region: upstreams run in safe mode and the classifier blocks any
# explicit frame. The classifier is still required, because it is what checks for nudity.
# Off at launch: no image, voice or video route exists until this is true, and production refuses to start with it on
# unless ANONYMO_MEDIA_CLASSIFIER_URL is set (Hive with Thorn's Safer and celebrity recognition are the planned checks).
ANONYMO_FEATURE_MEDIA=false
ANONYMO_COMFY_URL=https://comfy.internal.example.invalid
ANONYMO_COMFY_TOKEN=<secret>
ANONYMO_MEDIA_CLASSIFIER_URL=https://media-gate.internal.example.invalid
ANONYMO_MEDIA_CLASSIFIER_TOKEN=<secret>
ANONYMO_WATERMARK_URL=https://watermark.internal.example.invalid
ANONYMO_WATERMARK_TOKEN=<secret>
ANONYMO_PROVENANCE_KEY=<secret>
ANONYMO_WATERMARK_KEY=<secret>

# ---- money (WS05): JSON configs, see gateway/src/anonymo/deposits/config.ts ------------------------------------------
ANONYMO_EVM_CHAINS=
ANONYMO_SOLANA=
ANONYMO_TRON=
ANONYMO_BTCPAY=
# Paying with the Pons-launched coin (CoinPay; price from its Uniswap v4 USDG pool); see LAUNCH.md.
ANONYMO_COIN=
# Withdrawal hot wallet (anonymo-worker only). The Safe tops it up with a float; larger withdrawals wait for an operator.
ANONYMO_PAYOUT_PRIVATE_KEY=<secret>
ANONYMO_PAYOUT_MAX_USD=500
ANONYMO_PAYOUT_DAILY_MAX_USD=2000
ANONYMO_SANCTIONS_ENABLED=true
ANONYMO_SANCTIONS_LIST_URL=
ANONYMO_WATCH_EVERY_MS=15000

# ---- backup (scripts/backup-offsite.ts) -------------------------------------------------------------------------------
BACKUP_REQUIRED=true
BACKUP_AGE_RECIPIENTS=age1<public recipient>
BACKUP_S3_ENDPOINT=https://s3.example.invalid
BACKUP_S3_REGION=auto
BACKUP_S3_BUCKET=anonymo-backups
BACKUP_S3_PREFIX=prod/
BACKUP_S3_ACCESS_KEY_ID=<secret>
BACKUP_S3_SECRET_ACCESS_KEY=<secret>

# ---- monitoring (compose.monitoring.yml) -----------------------------------------------------------------------------
PROMETHEUS_IMAGE=prom/prometheus:v3.5.0@sha256:63805ebb8d2b3920190daf1cb14a60871b16fd38bed42b857a3182bc621f4996
ALERTMANAGER_IMAGE=prom/alertmanager:v0.34.1@sha256:e9733bafb1bdef9b00e25a21f8f99dc26a22224bf16641ad754d1649f4c3357a
ALERT_WEBHOOK_URL_FILE=/srv/anonymo/alert-webhook-url
# The exporter reads Postgres as the runtime role (SELECT only on the tables it names) and probes the guard models.
EXPORTER_DATABASE_URL=postgres://anonymo_runtime:<secret>@postgres:5432/anonymo
